                <TextStyle fontFamily="Arial" fontSize="10.0"/>
            </TextLine>
            <TextLine id="r19l8" primaryLanguage="German" custom="readingOrder {index:7;}">
                <Coords points="977,2180 1840,2183 1842,2219 978,2219"/>
                <Baseline points="979,2213 1448,2210 1839,2215"/>
