                <TextStyle fontFamily="Arial" fontSize="10.5" bold="true"/>
            </TextLine>
            <TextLine id="r9l19" primaryLanguage="German" custom="readingOrder {index:18;}">
                <Coords points="953,1530 1794,1532 1793,1493 951,1493 945,1512"/>
                <Baseline points="957,1522 1788,1520"/>
                <TextEquiv>
                    <Unicode>ſes nach andern Orten, und haͤtten die Aſſekuranz, die</Unicode>
