                <Coords points="954,1565 1789,1567 1791,1531 952,1531 948,1550"/>
                <Baseline points="960,1557 1783,1559"/>
                <TextEquiv>
                    <Unicode>1 ½ Prozent zu ſeyn pflegte, zu 10 Prozent erhoͤht. Von</Unicode>
