            <TextLine id="r9l11" primaryLanguage="German" custom="readingOrder {index:10;}">
                <Coords points="955,1234 1796,1234 1796,1196 955,1196 950,1213"/>
                <Baseline points="959,1227 1789,1227"/>
                <TextEquiv>
                    <Unicode>Caren zu tragen. Was das traurigſte fey, ſo verſiegten</Unicode>
