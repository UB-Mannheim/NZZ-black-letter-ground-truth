                <Baseline points="945,881 1800,868"/>
                <TextEquiv>
                    <Unicode>genen Tedeums, heimlich herum, und es wuͤrden beſonders</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r13l3" primaryLanguage="German" custom="readingOrder {index:2;}">
                <Coords points="1802,881 945,888 946,926 1802,921 1802,885"/>
                <Baseline points="947,920 1335,918 1802,911"/>
                <TextEquiv>
                    <Unicode>die meiſten vom Lande zuruͤckkehrenden Perſonen noch nach⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r13l4" primaryLanguage="German" custom="readingOrder {index:3;}">
                <Coords points="1282,966 1282,931 946,931 946,970"/>
                <Baseline points="946,962 1279,962"/>
                <TextEquiv>
                    <Unicode>traͤglich davon befallen.</Unicode>
