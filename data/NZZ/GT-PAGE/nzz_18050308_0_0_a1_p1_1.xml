        <TextRegion type="paragraph" id="r15" custom="readingOrder {index:16;}">
            <Coords points="943,1007 1826,1006 1825,2244 943,2246 946,2101"/>
            <TextLine id="r15l1" primaryLanguage="German" custom="readingOrder {index:0;}">
                <Coords points="982,1052 1804,1043 1804,1005 979,1015"/>
                <Baseline points="985,1046 1801,1038"/>
                <TextEquiv>
                    <Unicode>Schon ſeit geraumer Zeit beſchaͤftigt ein neu zu errichten⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l2" primaryLanguage="German" custom="readingOrder {index:1;}">
                <Coords points="946,1094 1805,1087 1805,1049 1288,1055 946,1054"/>
                <Baseline points="946,1089 1799,1081"/>
                <TextEquiv>
                    <Unicode>des Gouvernement auf Prinz⸗Wales⸗Inſel (unter Pegu)</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l3" primaryLanguage="German" custom="readingOrder {index:2;}">
                <Coords points="946,1098 946,1134 1253,1134 1807,1127 1805,1092"/>
                <Baseline points="948,1128 1328,1127 1803,1120"/>
                <TextEquiv>
                    <Unicode>die Parteyen heftig. Indeſſen haͤlt man dies koſtſpielige Pro⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l4" primaryLanguage="German" custom="readingOrder {index:3;}">
                <Coords points="946,1142 946,1179 1806,1169 1806,1132"/>
                <Baseline points="946,1174 1345,1171 1803,1161"/>
                <TextEquiv>
                    <Unicode>jekt allgemein bloß fuͤr eine pfiffige Spekulation, um Lord</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l5" primaryLanguage="German" custom="readingOrder {index:4;}">
                <Coords points="947,1221 1807,1211 1807,1174 947,1184"/>
                <Baseline points="948,1215 1323,1213 1804,1203"/>
                <TextEquiv>
                    <Unicode>Melvil's (Dundas) Neffen, dem Kapitaͤn Philipp Dun⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l6" primaryLanguage="German" custom="readingOrder {index:5;}">
                <Coords points="1807,1215 948,1227 946,1260 1409,1259 1807,1252"/>
                <Baseline points="948,1256 1345,1254 1806,1245"/>
                <TextEquiv>
                    <Unicode>das aus dem Seckel der Kompagnie eine fette Pfruͤnde zu</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l7" primaryLanguage="German" custom="readingOrder {index:6;}">
                <Coords points="1805,1257 949,1268 947,1302 1805,1297"/>
                <Baseline points="950,1299 1328,1297 1804,1287"/>
                <TextEquiv>
                    <Unicode>ſchneiden. Er ſoll Gouverneur dieſer Inſel mit 9000. Pf.</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l8" primaryLanguage="German" custom="readingOrder {index:7;}">
                <Coords points="1251,1306 947,1307 948,1346 1317,1344 1808,1335 1808,1301"/>
                <Baseline points="950,1341 1348,1338 1805,1331"/>
                <TextEquiv>
                    <Unicode>Gehalt werden. Ein naher Verwandter des Lords Mel⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l9" primaryLanguage="German" custom="readingOrder {index:8;}">
                <Coords points="1315,1347 945,1350 946,1387 1280,1387 1809,1379 1809,1340"/>
                <Baseline points="949,1383 1806,1373"/>
                <TextEquiv>
                    <Unicode>vil, ein H. Oliphant, ſoll erſter Magazin⸗Aufſeher, mit</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="r15l10" primaryLanguage="German" custom="readingOrder {index:9;}">
                <Coords points="947,1393 946,1430 1807,1420 1807,1384"/>
                <Baseline points="949,1424 1804,1415"/>
                <TextEquiv>
                    <Unicode>4500. Pfund Gehalt, werden, u. ſ. f. u. f. Der Vorwand</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l11" primaryLanguage="German" custom="readingOrder {index:10;}">
                <Coords points="948,1433 947,1471 1808,1466 1808,1426"/>
                <Baseline points="949,1466 1806,1456"/>
                <TextEquiv>
                    <Unicode>zu einem ſolchen Aufwande von 1. ½ Million Pfund</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l12" primaryLanguage="German" custom="readingOrder {index:11;}">
                <Coords points="1367,1472 949,1477 949,1511 1806,1506 1806,1467"/>
                <Baseline points="950,1507 1802,1498"/>
                <TextEquiv>
                    <Unicode>Sterl. jaͤhrlich mehr iſt, daß auf jener Inſel, die hoͤchſtens</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l13" primaryLanguage="German" custom="readingOrder {index:12;}">
                <Coords points="949,1518 949,1554 1806,1547 1806,1512"/>
                <Baseline points="952,1548 1406,1546 1804,1541"/>
                <TextEquiv>
                    <Unicode>150. Quadratmeilen enthaͤlt, wovon nur ein Drittel ange⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l14" primaryLanguage="German" custom="readingOrder {index:13;}">
                <Coords points="1440,1556 950,1559 949,1595 1484,1593 1808,1588 1806,1551"/>
                <Baseline points="951,1591 1807,1583"/>
                <TextEquiv>
                    <Unicode>baut werden kann, vortrefliche Schiffswerfte und Arſenale</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l15" primaryLanguage="German" custom="readingOrder {index:14;}">
                <Coords points="951,1600 950,1638 1809,1632 1809,1595"/>
                <Baseline points="952,1633 1367,1630 1807,1623"/>
                <TextEquiv>
                    <Unicode>fuͤr die oſtindiſche Schiffahrt angelegt werden koͤnnten. Allein</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l16" primaryLanguage="German" custom="readingOrder {index:15;}">
                <Coords points="951,1643 949,1679 1807,1673 1807,1638"/>
                <Baseline points="952,1675 1805,1668"/>
                <TextEquiv>
                    <Unicode>es iſt aktenmaͤßig bewieſen, daß die Schiffswerfte zu Cal⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l17" primaryLanguage="German" custom="readingOrder {index:16;}">
                <Coords points="951,1686 950,1721 1807,1715 1807,1680"/>
                <Baseline points="952,1716 1803,1709"/>
                <TextEquiv>
                    <Unicode>cutta alle moͤglichen Bequemlichkeiten und Ueberfluß des</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l18" primaryLanguage="German" custom="readingOrder {index:17;}">
                <Coords points="949,1729 950,1765 1805,1756 1806,1721"/>
                <Baseline points="953,1760 1803,1751"/>
                <TextEquiv>
                    <Unicode>herrlichſten Bauholzes nebſt treflichen Arbeitern darbieten,</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l19" primaryLanguage="German" custom="readingOrder {index:18;}">
                <Coords points="950,1770 949,1805 1807,1800 1808,1766"/>
                <Baseline points="952,1801 1807,1793"/>
                <TextEquiv>
                    <Unicode>und daß auf der Prinz⸗Wales⸗Inſel alles 50. Procent theu⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l20" primaryLanguage="German" custom="readingOrder {index:19;}">
                <Coords points="949,1811 950,1848 1809,1842 1809,1805"/>
                <Baseline points="953,1842 1358,1840 1807,1834"/>
                <TextEquiv>
                    <Unicode>rer iſt, als in den ſchon vorhandenen oſtindiſchen Schiffs⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l21" primaryLanguage="German" custom="readingOrder {index:20;}">
                <Coords points="952,1852 952,1890 1807,1885 1807,1847"/>
                <Baseline points="952,1884 1804,1876"/>
                <TextEquiv>
                    <Unicode>werften. In der Sitzung vom 4. Febr. hatte nunmehr das</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l22" primaryLanguage="German" custom="readingOrder {index:21;}">
                <Coords points="950,1896 950,1932 1808,1925 1809,1889"/>
                <Baseline points="953,1925 1369,1924 1807,1919"/>
                <TextEquiv>
                    <Unicode>Unterhaus verordnet, daß ihm alle auf dieſe neue Niederlaſ⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l23" primaryLanguage="German" custom="readingOrder {index:22;}">
                <Coords points="954,1937 952,1974 1809,1969 1809,1932"/>
                <Baseline points="953,1967 1350,1968 1808,1964"/>
                <TextEquiv>
                    <Unicode>ſung Bezug habenden Papiere vorgelegt werden ſollten. Die</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l24" primaryLanguage="German" custom="readingOrder {index:23;}">
                <Coords points="952,1978 951,2015 1809,2011 1810,1977"/>
                <Baseline points="953,2009 1358,2009 1807,2005"/>
                <TextEquiv>
                    <Unicode>oſtindiſchen Direktoren hatten den diesfaͤlligen Plan, gegen</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l25" primaryLanguage="German" custom="readingOrder {index:24;}">
                <Coords points="952,2019 952,2059 1808,2056 1808,2015"/>
                <Baseline points="953,2051 1347,2051 1809,2048"/>
                <TextEquiv>
                    <Unicode>die Proteſtation von einer Minoritaͤt von 318. Aktienbeſi⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l26" primaryLanguage="German" custom="readingOrder {index:25;}">
                <Coords points="952,2101 1723,2095 1721,2061 952,2064"/>
                <Baseline points="955,2095 1318,2093 1720,2089"/>
                <TextEquiv>
                    <Unicode>zern, in der letzten Generalverſammlung durchgeſetzt.</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l27" primaryLanguage="German" custom="readingOrder {index:26;}">
                <Coords points="989,2104 987,2144 1807,2139 1807,2101"/>
                <Baseline points="991,2138 1806,2133"/>
                <TextEquiv>
                    <Unicode>Die Geruͤchte, daß H. Pitt ſich aus dem Miniſterium ent⸗</Unicode>
                </TextEquiv>
            </TextLine>
            <TextLine id="r15l28" primaryLanguage="German" custom="readingOrder {index:27;}">
                <Coords points="952,2148 953,2186 1807,2181 1805,2144"/>
                <Baseline points="957,2179 1352,2178 1805,2173"/>
                <TextEquiv>
                    <Unicode>fernen wuͤrde, hatten abgenommen, ſeitdem er am 6. Febr.</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="13.0"/>
            </TextLine>
            <TextLine id="r15l29" primaryLanguage="German" custom="readingOrder {index:28;}">
                <Coords points="948,2190 948,2232 1806,2232 1806,2190"/>
