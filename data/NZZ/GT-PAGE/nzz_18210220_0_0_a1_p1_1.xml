                    <Unicode>tion duͤrfte bey dieſer Veraͤnderung nicht anders als gewinnen.</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r13l13" primaryLanguage="German" custom="readingOrder {index:12;}">
                <Coords points="920,2193 96,2195 87,2234 928,2235 929,2210"/>
                <Baseline points="99,2227 926,2225"/>
                <TextEquiv>
                    <Unicode>Kurz vorher hieß es, es ſey in einem Staatsrath be⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
        </TextRegion>
        <TextRegion type="paragraph" id="r14" custom="readingOrder {index:15;} structure {type:paragraph;}">
            <Coords points="939,806 1817,804 1825,935 940,933"/>
            <TextLine id="r14l1" primaryLanguage="German" custom="readingOrder {index:0;}">
                <Coords points="1812,813 943,812 945,850 1811,850"/>
                <Baseline points="949,844 1812,843"/>
                <TextEquiv>
                    <Unicode>ſchloſſen worden, den Namen der Koͤnigin wieder dem Kir⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r14l2" primaryLanguage="German" custom="readingOrder {index:1;}">
                <Coords points="1812,857 947,856 945,890 1810,892"/>
                <Baseline points="947,886 1808,884"/>
                <TextEquiv>
                    <Unicode>chengebet einzuverleiben, was ſich aber, ſeit dem Ausgang</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r14l3" primaryLanguage="German" custom="readingOrder {index:2;}">
                <Coords points="945,931 1681,933 1689,899 947,898"/>
                <Baseline points="947,928 1669,926"/>
                <TextEquiv>
                    <Unicode>der vorerwaͤhnten Sitzung, nicht beſtaͤtigen duͤrfte.</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
        </TextRegion>
        <TextRegion type="paragraph" id="r15" custom="readingOrder {index:16;}">
            <Coords points="938,939 1832,936 1835,1306 944,1311"/>
            <TextLine id="r15l1" primaryLanguage="German" custom="readingOrder {index:0;}">
                <Coords points="1814,938 979,940 971,976 1817,975 1820,938"/>
                <Baseline points="983,970 1813,967"/>
                <TextEquiv>
                    <Unicode>Uebrigens hatte die Sache der gedachten Prinzeſſin in der</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l2" primaryLanguage="German" custom="readingOrder {index:1;}">
                <Coords points="1814,981 949,980 947,1015 1809,1017"/>
                <Baseline points="950,1010 1809,1010"/>
                <TextEquiv>
                    <Unicode>oͤffentlichen Meynung, durch das Ausſchlagen der ihr von dem</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l3" primaryLanguage="German" custom="readingOrder {index:2;}">
                <Coords points="1814,1022 948,1021 947,1060 1811,1058"/>
                <Baseline points="952,1052 1810,1051"/>
                <TextEquiv>
                    <Unicode>Parlamente votirten 50,000. Pf. Sterl. ehe ſie nicht erſt</Unicode>
                </TextEquiv>
