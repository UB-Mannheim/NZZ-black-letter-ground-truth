                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r19l11" primaryLanguage="German" custom="readingOrder {index:10;}">
                <Coords points="951,2233 1786,2236 1794,2191 953,2189"/>
