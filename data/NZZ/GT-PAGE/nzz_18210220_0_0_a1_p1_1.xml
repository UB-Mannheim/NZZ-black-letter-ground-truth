        <TextRegion type="paragraph" id="r16" custom="readingOrder {index:17;}">
            <Coords points="948,1314 1839,1313 1840,1553 946,1560"/>
            <TextLine id="r16l1" primaryLanguage="German" custom="readingOrder {index:0;}">
                <Coords points="1824,1313 981,1315 981,1349 1824,1350"/>
                <Baseline points="986,1344 1818,1343"/>
                <TextEquiv>
                    <Unicode>Als juͤngſthin der Koͤnig aus dem Theater nach Carlon⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r16l2" primaryLanguage="German" custom="readingOrder {index:1;}">
                <Coords points="951,1393 1822,1390 1821,1356 953,1355"/>
                <Baseline points="954,1385 1814,1384"/>
                <TextEquiv>
                    <Unicode>Hauſe zuruͤckfuhr, wurde er uͤberall mit dem Geſchrei:</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r16l3" primaryLanguage="German" custom="readingOrder {index:2;}">
                <Coords points="950,1434 1821,1432 1821,1399 954,1398 951,1431"/>
                <Baseline points="955,1428 1813,1426"/>
                <TextEquiv>
                    <Unicode>„Es lebe die Koͤnigin“! umzingelt, und die Gaſſenjungen</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r16l4" primaryLanguage="German" custom="readingOrder {index:3;}">
                <Coords points="951,1473 1822,1473 1822,1440 950,1441"/>
                <Baseline points="953,1469 1813,1469"/>
                <TextEquiv>
                    <Unicode>riefen ihm zu: „Wo iſt Eure Frau, warum habt Ihr ſie</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r16l5" primaryLanguage="German" custom="readingOrder {index:4;}">
                <Coords points="954,1518 1824,1518 1822,1479 950,1480 951,1502"/>
                <Baseline points="953,1511 1814,1509"/>
                <TextEquiv>
                    <Unicode>nicht bey Euch“? Und Andre: „Gott erhalte den Koͤnig,</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r16l6" primaryLanguage="German" custom="readingOrder {index:5;}">
                <Coords points="949,1558 1440,1557 1448,1520 952,1518 951,1554"/>
                <Baseline points="954,1552 1422,1551"/>
                <TextEquiv>
                    <Unicode>und verdamme ſeine Miniſter!”</Unicode>
                </TextEquiv>
            </TextLine>
