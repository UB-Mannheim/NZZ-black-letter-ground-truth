            </TextLine>
            <TextLine id="r15l4" primaryLanguage="German" custom="readingOrder {index:3;}">
                <Coords points="1814,1064 950,1063 947,1100 1813,1100"/>
                <Baseline points="949,1095 1813,1092"/>
                <TextEquiv>
                    <Unicode>in alle ihre Rechte eingeſetzt wuͤrde, wieder merklich ge⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l5" primaryLanguage="German" custom="readingOrder {index:4;}">
                <Coords points="1814,1106 950,1105 946,1142 1813,1140"/>
                <Baseline points="951,1136 1812,1135"/>
                <TextEquiv>
                    <Unicode>wonnen, und man ſprach von 200,000. Pfund welche ihre</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l6" primaryLanguage="German" custom="readingOrder {index:5;}">
                <Coords points="1814,1149 951,1148 946,1184 1813,1183"/>
                <Baseline points="953,1177 1812,1175"/>
                <TextEquiv>
                    <Unicode>Freunde zuſammenſchießen und die (nach welcher Berech⸗</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l7" primaryLanguage="German" custom="readingOrder {index:6;}">
                <Coords points="1814,1185 951,1191 948,1226 1813,1225"/>
                <Baseline points="950,1219 1812,1218"/>
                <TextEquiv>
                    <Unicode>nung?) fuͤr ihre Beduͤrfniſſe bis zu dem Tod des Koͤniges</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l8" primaryLanguage="German" custom="readingOrder {index:7;}">
                <Coords points="1814,1228 951,1229 950,1267 1812,1268"/>
                <Baseline points="950,1261 1814,1259"/>
                <TextEquiv>
                    <Unicode>wohl hinreichen duͤrften, wo ihr dann die 50,000. Pfund</Unicode>
                </TextEquiv>
                <TextStyle fontFamily="Times New Roman" fontSize="12.0"/>
            </TextLine>
            <TextLine id="r15l9" primaryLanguage="German" custom="readingOrder {index:8;}">
                <Coords points="948,1308 1778,1305 1775,1273 953,1271"/>
                <Baseline points="953,1303 1769,1301"/>
